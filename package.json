{
  "name": "shelfie",
  "version": "0.0.0",
  "private": true,
  "description": "Shelfie monorepo — web, api ve (ileride) mobil uygulamalar.",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @shelfie/web dev",
    "dev:api": "pnpm --filter @shelfie/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
