// Shelfie veri modeli.
// Kullanıcı kimliği Firebase'den gelir; User.id doğrudan Firebase uid'sidir,
// bu yüzden ayrı bir parola/oturum tablosu yok.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  email       String?  @unique
  displayName String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  books Book[]

  @@map("users")
}

model Book {
  id            String    @id @default(cuid())
  userId        String
  title         String
  author        String
  pages         Int       @default(0)
  isbn          String?
  publishedYear Int?
  genre         String?
  rating        Int?
  notes         String?
  coverUrl      String?

  // Kitabın durumu: bitmişse completed, değilse wantToRead ise okuma
  // listesinde, ikisi de değilse devam ediyor sayılır.
  isCompleted Boolean @default(false)
  isFavorite  Boolean @default(false)
  wantToRead  Boolean @default(false)

  startDate DateTime? @db.Date
  endDate   DateTime? @db.Date
  dateRead  DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@index([userId])
  @@index([userId, isCompleted])
  @@index([userId, isFavorite])
  @@map("books")
}

model Quote {
  id        String   @id @default(cuid())
  bookId    String
  text      String
  page      Int?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("quotes")
}
